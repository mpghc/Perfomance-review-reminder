@page "/notifications"
@using PerformanceReviewReminderBot.Web.Entities
@using PerformanceReviewReminderBot.Web.Services
@rendermode InteractiveServer
@inject NotificationService NotificationService
@inject CurrentUserService CurrentUser

<PageTitle>Inbox — ReviewPulse</PageTitle>

<h1>Inbox</h1>

@if (notifications is null)
{
    <p><em>Loading...</em></p>
}
else if (notifications.Count == 0)
{
    <p class="text-muted">No notifications yet.</p>
}
else
{
    <div class="list-group">
        @foreach (var n in notifications)
        {
            <div class="list-group-item d-flex justify-content-between align-items-start @(n.IsRead ? "" : "list-group-item-warning")">
                <div class="ms-2 me-auto">
                    <div class="@(n.IsRead ? "" : "fw-bold")">
                        <span class="badge @GetTypeBadgeClass(n.Type) me-1">@n.Type</span>
                        @n.Message
                    </div>
                    <small class="text-muted">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                </div>
                @if (!n.IsRead)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => MarkAsReadAsync(n.Id)">
                        Mark as read
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    private List<Notification>? notifications;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotificationsAsync();
    }

    private async Task LoadNotificationsAsync()
    {
        notifications = await NotificationService.GetByRecipientAsync(CurrentUser.CurrentUserId);
    }

    private async Task MarkAsReadAsync(int notificationId)
    {
        await NotificationService.MarkAsReadAsync(notificationId);
        await LoadNotificationsAsync();
    }

    private static string GetTypeBadgeClass(NotificationType type) => type switch
    {
        NotificationType.Reminder => "bg-info text-dark",
        NotificationType.Overdue => "bg-danger",
        _ => "bg-secondary"
    };
}
