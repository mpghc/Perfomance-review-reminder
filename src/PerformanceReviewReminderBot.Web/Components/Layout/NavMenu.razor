@using PerformanceReviewReminderBot.Web.Components.Shared
@using PerformanceReviewReminderBot.Web.Entities
@using PerformanceReviewReminderBot.Web.Services
@rendermode InteractiveServer
@inject CurrentUserService CurrentUser
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ReviewPulse</a>
    </div>
</div>

<div class="px-3 py-2">
    <RoleSwitcher />
</div>

<div class="px-3 py-1">
    <NotificationBadge />
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @if (CurrentUser.CurrentUserRole == EmployeeRole.TalentManager)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="dashboard">
                    <span class="bi bi-speedometer-nav-menu" aria-hidden="true"></span> Dashboard
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reviews">
                    <span class="bi bi-calendar-check-nav-menu" aria-hidden="true"></span> Reviews
                </NavLink>
            </div>
        }

        @if (CurrentUser.CurrentUserRole == EmployeeRole.Employee)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="feedback">
                    <span class="bi bi-chat-dots-nav-menu" aria-hidden="true"></span> Feedback
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="notifications">
                <span class="bi bi-bell-nav-menu" aria-hidden="true"></span> Inbox
            </NavLink>
        </div>

        @if (CurrentUser.CurrentUserRole == EmployeeRole.TalentManager)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/employees">
                    <span class="bi bi-gear-nav-menu" aria-hidden="true"></span> Admin
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        CurrentUser.OnChange += OnCurrentUserChanged;
    }

    private void OnCurrentUserChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CurrentUser.OnChange -= OnCurrentUserChanged;
    }
}

