@page "{id:int}"
@model PerformanceReviewBot.Pages.Employees.DeleteModel
@{
    ViewData["Title"] = "Delete Employee";
}

<h2>Delete Employee</h2>

<div class="alert alert-danger">
    <h5>Are you sure you want to delete this employee?</h5>
    <p>This will also delete all associated performance reviews.</p>
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Employee.FirstName)</dt>
            <dd class="col-sm-9">@Model.Employee.FirstName</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Employee.LastName)</dt>
            <dd class="col-sm-9">@Model.Employee.LastName</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Employee.Email)</dt>
            <dd class="col-sm-9">@Model.Employee.Email</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Employee.Department)</dt>
            <dd class="col-sm-9">@Model.Employee.Department</dd>
        </dl>
    </div>
</div>

<form method="post">
    <input type="hidden" asp-for="Employee.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
