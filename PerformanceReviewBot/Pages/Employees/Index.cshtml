@page
@model PerformanceReviewBot.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "Employees";
}

<h2>Employees</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Employee</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Employees[0].FirstName)</th>
            <th>@Html.DisplayNameFor(model => model.Employees[0].LastName)</th>
            <th>@Html.DisplayNameFor(model => model.Employees[0].Email)</th>
            <th>@Html.DisplayNameFor(model => model.Employees[0].Department)</th>
            <th>@Html.DisplayNameFor(model => model.Employees[0].HireDate)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Employees)
        {
            <tr>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.Email</td>
                <td>@item.Department</td>
                <td>@item.HireDate.ToShortDateString()</td>
                <td>
                    <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
