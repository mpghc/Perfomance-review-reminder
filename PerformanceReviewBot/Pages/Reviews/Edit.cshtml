@page "{id:int}"
@model PerformanceReviewBot.Pages.Reviews.EditModel
@{
    ViewData["Title"] = "Edit Review";
}

<h2>Edit Review</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Review.Id" />
            <div class="mb-3">
                <label asp-for="Review.EmployeeId" class="form-label"></label>
                <select asp-for="Review.EmployeeId" asp-items="Model.EmployeeList" class="form-select">
                    <option value="">-- Select Employee --</option>
                </select>
                <span asp-validation-for="Review.EmployeeId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Review.ReviewDate" class="form-label"></label>
                <input asp-for="Review.ReviewDate" class="form-control" type="date" />
                <span asp-validation-for="Review.ReviewDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Review.Status" class="form-label"></label>
                <select asp-for="Review.Status" asp-items="Model.StatusList" class="form-select"></select>
                <span asp-validation-for="Review.Status" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Review.Notes" class="form-label"></label>
                <textarea asp-for="Review.Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Review.Notes" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
