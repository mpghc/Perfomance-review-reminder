@page "{id:int}"
@model PerformanceReviewBot.Pages.Reviews.DeleteModel
@{
    ViewData["Title"] = "Delete Review";
}

<h2>Delete Review</h2>

<div class="alert alert-danger">
    <h5>Are you sure you want to delete this review?</h5>
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Employee</dt>
            <dd class="col-sm-9">@Model.Review.Employee.FullName</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Review.ReviewDate)</dt>
            <dd class="col-sm-9">@Model.Review.ReviewDate.ToShortDateString()</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Review.Status</dd>

            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@Model.Review.Notes</dd>
        </dl>
    </div>
</div>

<form method="post">
    <input type="hidden" asp-for="Review.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
