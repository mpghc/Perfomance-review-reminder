@page "{id:int}"
@model PerformanceReviewBot.Pages.Reviews.DetailsModel
@{
    ViewData["Title"] = "Review Details";
}

<h2>Review Details</h2>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Employee</dt>
            <dd class="col-sm-9">@Model.Review.Employee.FullName</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Review.ReviewDate)</dt>
            <dd class="col-sm-9">@Model.Review.ReviewDate.ToShortDateString()</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Review.Status == "Overdue")
                {
                    <span class="badge bg-danger">@Model.Review.Status</span>
                }
                else if (Model.Review.Status == "Completed")
                {
                    <span class="badge bg-success">@Model.Review.Status</span>
                }
                else
                {
                    <span class="badge bg-primary">@Model.Review.Status</span>
                }
            </dd>

            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@Model.Review.Notes</dd>
        </dl>
    </div>
</div>

<div>
    <a asp-page="Edit" asp-route-id="@Model.Review.Id" class="btn btn-warning">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
</div>
